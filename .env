# ==========================================
# StudyGen - Agentic AI Study Planner Environment
# ==========================================

ENVIRONMENT=development
PROJECT_NAME="StudyGen — Agentic AI Study Planner"
API_V1_STR="/api/v1"
SECRET_KEY=studygen-super-secret-dev-key-for-hackathon-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (Defaults to SQLite for instant plug-and-play local dev)
DATABASE_URL=sqlite+aiosqlite:///./studygen.db

# LLM Providers (OpenAI, Gemini, or MockProvider)
DEFAULT_LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Vector Database
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION=studygen_notes

# Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# MLOps & Experiment Tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=studygen_mastery_predictor

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
