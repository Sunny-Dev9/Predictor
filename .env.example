# ==========================================
# StudyGen - Agentic AI Study Planner Environment
# ==========================================

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="StudyGen — Agentic AI Study Planner"
API_V1_STR="/api/v1"
SECRET_KEY=studygen-super-secret-production-key-change-in-prod-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL / SQLite fallback)
# For Postgres (Docker/Production): postgresql+asyncpg://postgres:postgres@localhost:5432/studygen
# For SQLite (Instant Local Dev): sqlite+aiosqlite:///./studygen.db
DATABASE_URL=sqlite+aiosqlite:///./studygen.db

# LLM Providers (OpenAI, Gemini, or MockProvider)
# DEFAULT_LLM_PROVIDER can be 'mock', 'openai', or 'gemini'
DEFAULT_LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Vector Database (Qdrant)
# Leave empty or set to ':memory:' for instant local in-memory Qdrant
# For standalone Docker: http://localhost:6333
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION=studygen_notes

# Cache & Message Broker (Redis & Celery)
REDIS_URL=redis://localhost:6379/0

# MLOps & Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=studygen_mastery_predictor

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
